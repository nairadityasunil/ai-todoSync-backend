{
  "name": "pristine-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"npm run build && node dist/server.js\"",
    "build": "tsc",
    "test": "tsx --test $(grep -rL 'mongoose.connect(' --include='*.test.ts' src | sort)",
    "test:integration": "tsx --test $(grep -rl 'mongoose.connect(' --include='*.test.ts' src | sort)",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "prepare": "husky install",
    "check:console": "tsx src/scripts/checks/noConsoleCheck.ts",
    "check:semantic": "tsx src/scripts/checks/semanticRegressionCheck.ts",
    "check:env": "tsx src/scripts/checks/envCheck.ts",
    "check:branch": "tsx src/scripts/checks/branchCheck.ts",
    "check:all": "node dist/scripts/checks/allCustomChecks.js",
    "seed:semantic-scenarios": "tsx src/scripts/seedSemanticOperationalScenarios.ts",
    "test:engagement": "npx tsx --test src/modules/**/*.test.ts",
    "test:sdk-integrations": "npx tsx --test src/modules/sdk-integrations/sdk-integrations.test.ts",
    "test:sdk-api": "npx tsx src/scripts/test-sdk-integration-api.ts",
    "test:ai-planning": "tsx --test src/modules/ai-planner/services/ai-planning.service.test.ts",
    "test:prompt-ops": "tsx --test src/modules/prompt/services/prompt-library.service.test.ts",
    "migrate:project-team": "tsx src/scripts/migrations/backfillProjectMembers.ts",
    "migrate:legacy-refs": "tsx src/scripts/migrations/backfillLegacyReferenceIds.ts",
    "migrate:polymorphic-notes": "tsx src/scripts/migrations/backfillPolymorphicNotes.ts",
    "migrate:sla": "tsx src/scripts/migrations/backfillSlaFields.ts",
    "migrate:audit-priority": "tsx src/scripts/migrations/backfillAuditAndPriority.ts",
    "type-check": "tsc --noEmit",
    "depcheck": "depcheck",
    "jscpd": "jscpd",
    "precommit": "npm run check:console && npm run check:env && lint-staged && npm run lint",
    "prepush": "npm run type-check && npm run build && npm run check:all && npm run lint"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "depcheck": "^1.4.7",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "jscpd": "^4.0.8",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
