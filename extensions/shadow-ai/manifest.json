{
  "manifest_version": 3,
  "name": "Pristine Shadow AI",
  "version": "1.0.0",
  "description": "Tells you whether an AI tool is approved, and checks what you paste into it for passwords, keys and personal data.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "alarms", "declarativeNetRequest"],
  "host_permissions": ["http://localhost:4000/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ai-gateway.vercel.sh/*",
        "*://*.aiplatform.googleapis.com/*",
        "*://*.aistudio.google.com/*",
        "*://*.anthropic.com/*",
        "*://*.api.anthropic.com/*",
        "*://*.api.cohere.ai/*",
        "*://*.api.cohere.com/*",
        "*://*.api.deepseek.com/*",
        "*://*.api.elevenlabs.io/*",
        "*://*.api.fireworks.ai/*",
        "*://*.api.groq.com/*",
        "*://*.api.mistral.ai/*",
        "*://*.api.openai.com/*",
        "*://*.api.perplexity.ai/*",
        "*://*.api.replicate.com/*",
        "*://*.api.smith.langchain.com/*",
        "*://*.api.stability.ai/*",
        "*://*.api.together.ai/*",
        "*://*.api.together.xyz/*",
        "*://*.api.x.ai/*",
        "*://*.api2.cursor.sh/*",
        "*://*.bolt.new/*",
        "*://*.character.ai/*",
        "*://*.chat.deepseek.com/*",
        "*://*.chat.mistral.ai/*",
        "*://*.chat.openai.com/*",
        "*://*.chatgpt.com/*",
        "*://*.claude.ai/*",
        "*://*.cloud.llamaindex.ai/*",
        "*://*.codeium.com/*",
        "*://*.cognitiveservices.azure.com/*",
        "*://*.cohere.ai/*",
        "*://*.cohere.com/*",
        "*://*.console.anthropic.com/*",
        "*://*.copilot-proxy.githubusercontent.com/*",
        "*://*.copilot.microsoft.com/*",
        "*://*.copy.ai/*",
        "*://*.cursor.com/*",
        "*://*.cursor.sh/*",
        "*://*.deepseek.com/*",
        "*://*.elevenlabs.io/*",
        "*://*.fathom.video/*",
        "*://*.fireflies.ai/*",
        "*://*.fireworks.ai/*",
        "*://*.gamma.app/*",
        "*://*.gemini.google.com/*",
        "*://*.generativelanguage.googleapis.com/*",
        "*://*.githubcopilot.com/*",
        "*://*.grammarly.com/*",
        "*://*.grok.com/*",
        "*://*.groq.com/*",
        "*://*.heygen.com/*",
        "*://*.hf.co/*",
        "*://*.huggingface.co/*",
        "*://*.ideogram.ai/*",
        "*://*.jasper.ai/*",
        "*://*.langchain.com/*",
        "*://*.leonardo.ai/*",
        "*://*.lindy.ai/*",
        "*://*.llamaindex.ai/*",
        "*://*.lmstudio.ai/*",
        "*://*.lovable.app/*",
        "*://*.lovable.dev/*",
        "*://*.manus.im/*",
        "*://*.meta.ai/*",
        "*://*.midjourney.com/*",
        "*://*.mistral.ai/*",
        "*://*.notebooklm.google.com/*",
        "*://*.ollama.ai/*",
        "*://*.ollama.com/*",
        "*://*.openai.azure.com/*",
        "*://*.openai.com/*",
        "*://*.openrouter.ai/*",
        "*://*.otter.ai/*",
        "*://*.perplexity.ai/*",
        "*://*.phind.com/*",
        "*://*.pika.art/*",
        "*://*.pinecone.io/*",
        "*://*.platform.openai.com/*",
        "*://*.poe.com/*",
        "*://*.quillbot.com/*",
        "*://*.read.ai/*",
        "*://*.replicate.com/*",
        "*://*.replit.com/*",
        "*://*.runwayml.com/*",
        "*://*.smith.langchain.com/*",
        "*://*.stability.ai/*",
        "*://*.suno.com/*",
        "*://*.synthesia.io/*",
        "*://*.tabnine.com/*",
        "*://*.together.ai/*",
        "*://*.v0.app/*",
        "*://*.v0.dev/*",
        "*://*.windsurf.com/*",
        "*://*.writesonic.com/*",
        "*://*.x.ai/*",
        "*://*.you.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Pristine Shadow AI",
    "default_popup": "popup.html"
  }
}
